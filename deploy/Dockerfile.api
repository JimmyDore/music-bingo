# API du bingo : node brut, node:sqlite, zéro dépendance npm.
FROM node:22-alpine
WORKDIR /app
COPY server/package.json ./
COPY server/*.mjs ./
# Le catalogue est lu au démarrage : un thème en plus = un fichier en plus.
COPY catalog ./catalog
ENV PORT=8787 \
    DB_PATH=/data/bingo.db \
    CATALOG_DIR=/app/catalog
VOLUME /data
EXPOSE 8787
CMD ["node", "index.mjs"]
